// 전체 자동화 업무 실행 함수
function runAllAutomations() {
  Logger.log('=== 자동화 업무를 시작합니다 ===');
  
  try {
    // 1. 파일 복사 및 원본 이름 변경
    Logger.log('[단계 1/4] 파일을 복사하고 이름을 변경합니다...');
    automateFileTask();
    
    // 2. 백데이터 수집 및 적재 (오늘 날짜까지 포함)
    Logger.log('[단계 2/4] 백데이터를 수집하고 동기화합니다...');
    syncCSData();
    
    // 3. 미처리 개수 세기 및 보고서 업데이트
    Logger.log('[단계 3/4] 미처리 건수를 계산하여 보고서에 반영합니다...');
    updateDailyIndicator();
    
    Logger.log('=== 모든 자동화 업무가 성공적으로 완료되었습니다 ===');
    
  } catch (e) {
    Logger.log('오류 발생: ' + e.toString());
  }
}

// 1. 파일 관리 함수
function automateFileTask() {
  const sourceFolder = DriveApp.getFolderById('1ZoKjYQ6LxZ3FzbOC1eggQOrRAmnTvcx5');
  const targetFolder = DriveApp.getFolderById('1iQNyvy1IZN0rPcC-nIul5__EjStKfplt');
  const files = sourceFolder.getFiles();
  
  if (files.hasNext()) {
    const sourceFile = files.next();
    const copy = sourceFile.makeCopy(sourceFile.getName(), targetFolder);
    copy.setName(sourceFile.getName());
    
    const yesterday = new Date();
    yesterday.setDate(yesterday.getDate() - 1);
    const dateString = Utilities.formatDate(yesterday, Session.getScriptTimeZone(), "yyMMdd");
    sourceFile.setName("[오딘 글로벌]Report_" + dateString);
  }
}

// 2. 백데이터 수집/적재 함수
function syncCSData() {
  const externalSs = SpreadsheetApp.openById('1xYrXAmVUox5TVs47YME_sZFEfM_19yeffBdwEJQHMgI');
  const sourceSheet = externalSs.getSheetByName('Main');
  const mySs = SpreadsheetApp.getActiveSpreadsheet();
  const targetSheet = mySs.getSheetByName('CS');

  sourceSheet.getRange('E1').setValue('ODIN:VALHALLA RISING');
  SpreadsheetApp.flush();
  Utilities.sleep(4000); 

  const today = new Date();
  const endDate = new Date(today); 
  const startDate = new Date(today);
  startDate.setDate(today.getDate() - 10); 

  const lastRow = sourceSheet.getLastRow();
  const lastCol = sourceSheet.getLastColumn();
  const sourceData = sourceSheet.getRange(7, 1, lastRow - 6, lastCol).getValues();
  
  const targetData = targetSheet.getDataRange().getValues();
  const dateToIndexMap = {};
  targetData.forEach((row, index) => { 
    if(index > 0 && row[0]) {
      const dateKey = Utilities.formatDate(new Date(row[0]), Session.getScriptTimeZone(), "yyyy. M. d.");
      dateToIndexMap[dateKey] = index + 1;
    }
  });

  sourceData.forEach(row => {
    if(!row[0]) return;
    const rowDate = new Date(row[0]);
    if (rowDate >= startDate && rowDate <= endDate) {
      const formattedDate = Utilities.formatDate(rowDate, Session.getScriptTimeZone(), "yyyy. M. d.");
      if (dateToIndexMap[formattedDate]) {
        targetSheet.getRange(dateToIndexMap[formattedDate], 1, 1, lastCol).setValues([row]);
      } else {
        targetSheet.appendRow(row);
      }
    }
  });
}

// 3. 미처리 개수 계산 및 업데이트 함수 (Daily_ 접두어 자동 탐색 버전)
function updateDailyIndicator() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const csSheet = ss.getSheetByName('CS');
  
  // 모든 시트 중 'Daily_'로 시작하는 첫 번째 시트를 자동으로 찾음
  const sheets = ss.getSheets();
  const targetSheet = sheets.find(sheet => sheet.getName().startsWith('Daily_'));
  
  if (!targetSheet) {
    Logger.log('오류: "Daily_"로 시작하는 시트를 찾을 수 없습니다.');
    return;
  }
  
  Logger.log('찾은 대상 시트: ' + targetSheet.getName());
  
  const lastRow = csSheet.getLastRow();
  if (lastRow < 7) return;
  
  const fColumnValues = csSheet.getRange(7, 6, lastRow - 6, 1).getValues();
  let totalProcessed = 0;
  fColumnValues.forEach(row => {
    if (typeof row[0] === 'number') totalProcessed += row[0];
  });
  
  targetSheet.getRange('I24').setValue("* 총 Mail CS 미처리 " + totalProcessed + "건 (금일 10시 기준)");
  Logger.log(targetSheet.getName() + ' 시트 업데이트 완료: ' + totalProcessed + '건');
}
